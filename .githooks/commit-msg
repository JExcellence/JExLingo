#!/usr/bin/env sh
# Keeps commits single-author: removes trailer lines and generated-by lines from the message.
# Enable once per clone: git config core.hooksPath .githooks
message_file="$1"
tmp_file="$message_file.tmp"
grep -viE '^(co-[a-z]+-by:|.*generated (with|by) )' "$message_file" > "$tmp_file" || true
mv "$tmp_file" "$message_file"
