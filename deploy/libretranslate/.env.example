# Copy to .env next to docker-compose.yml and adjust.

# Languages to load, comma separated, no spaces. Must match languages.enabled in plugins/JExLingo/config.yml.
LT_LANGUAGES=en,de

# Port on 127.0.0.1 that JExLingo connects to (provider.url in config.yml).
LT_PORT=5000

# Memory limit. en+de measured 2.98 GiB with 4 workers; plan roughly 1.5 GiB more per further language
# (estimate, check with docker stats).
LT_MEMORY=5g

# Longest text per request and requests per minute per client.
LT_CHAR_LIMIT=500
LT_REQ_LIMIT=600

# Image tag. Pin a version (for example v1.9.6) if you want updates only when you choose.
LT_VERSION=latest
